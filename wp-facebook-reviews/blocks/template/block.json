{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-fb-reviews/template",
	"version": "15.4",
	"title": "WP Review Slider",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Display a saved Facebook or Twitter review slider, grid, or badge.",
	"keywords": [ "facebook", "twitter", "reviews", "slider", "testimonials" ],
	"textdomain": "wp-fb-reviews",
	"attributes": {
		"templateId": {
			"type": "number",
			"default": 0
		}
	},
	"example": {
		"attributes": {
			"templateId": 0
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
